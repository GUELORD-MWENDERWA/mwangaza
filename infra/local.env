# Essai de la production sur la machine (`make prod-local`), jamais sur le serveur : valeurs
# publiques, certificat local de Caddy, domaine localhost (https://itig-demo.localhost/app/).
MWANGAZA_DOMAIN=localhost
CADDY_TLS=internal
DJANGO_SECRET_KEY=essai-local-seulement-ne-jamais-utiliser-sur-le-serveur
POSTGRES_PASSWORD=essai-local
POSTGRES_APP_PASSWORD=essai-local-application
# Sans HSTS : le navigateur continue d'accepter http://itig-demo.localhost:5173 (make dev).
DJANGO_HSTS_SECONDS=0
GUNICORN_WORKERS=2

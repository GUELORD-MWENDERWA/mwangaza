# Routes de chaque adresse, communes au vrai serveur (`production/Caddyfile`) et à l'essai
# `make prod-local` (`Caddyfile`) : seul le certificat change.

(django) {
	reverse_proxy django:8000 {
		# Lu par Django (`CLIENT_IP_HEADER`) ; remplace tout X-Real-IP envoyé par le visiteur.
		header_up X-Real-IP {client_ip}
	}
}

# En-têtes de sécurité des applications construites (S.1). La CSP part d'abord en
# `Content-Security-Policy-Report-Only` (le navigateur signale dans sa console sans bloquer) ;
# après une semaine sans signalement, mettre `CSP_HEADER=Content-Security-Policy` dans l'environnement
# de Caddy pour l'imposer. Ni `unsafe-eval` ni script en ligne ; `unsafe-inline` seulement pour les
# styles (Radix et Tailwind en posent). Caméra à ouvrir ici le jour du scan QR (`02`).
(securite) {
	header {
		Strict-Transport-Security "max-age=2592000; includeSubDomains"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		{$CSP_HEADER:Content-Security-Policy-Report-Only} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}

# Application construite : fichiers à empreinte gardés un an ; le reste (index.html, service
# worker, manifeste) revalidé à chaque visite, sinon un appareil garderait l'ancienne version.
(pwa) {
	root * {args[0]}
	@hashed path /assets/*
	@other not path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @other Cache-Control "no-cache"
	import securite
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	try_files {path} /index.html
	file_server
}

# Une école : {code}.mwangazaschool.com (le code est lu par Django dans le nom d'hôte).
(ecole) {
	handle /api/* {
		import django
	}
	# Vérification publique d'un reçu ou d'une situation financière (QR code).
	handle /v/* {
		import django
	}
	handle_path /app/* {
		import pwa /srv/gestion
	}
	# Plus tard : site vitrine de l'école (`03` § 2).
	handle {
		redir * /app/
	}
}

# Portail des familles (une famille peut avoir des enfants dans plusieurs écoles).
(parents) {
	handle /api/* {
		import django
	}
	handle {
		import pwa /srv/portail
	}
}

# Super-admin : console de la plateforme (5.2) ; l'administration Django, pour le dépannage, à la
# même adresse (même session).
(admin) {
	# `/admin` sans barre finale irait à la console (404) : on ajoute la barre.
	redir /admin /admin/
	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /api/* {
		import django
	}
	handle /admin/* {
		import django
	}
	handle {
		import pwa /srv/console
	}
}

# Production (`docs/03-architecture-technique.md` § 2 et § 9), derrière Cloudflare.
# Variables (`docker-compose.yml`) : MWANGAZA_DOMAIN (ex. mwangazaschool.com) et CADDY_TLS
# (certificat d'origine Cloudflare sur le serveur ; `internal` pour l'essai sur la machine).
{
	servers {
		# Adresse réelle du visiteur : `CF-Connecting-IP`, crue seulement si la requête vient de
		# Cloudflare (https://www.cloudflare.com/ips/, relevé le 2026-10-02). Une requête venue
		# d'ailleurs garde son adresse de connexion, quel que soit l'en-tête qu'elle envoie.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Routes de chaque adresse (`routes.caddy`).
import routes.caddy

(site) {
	tls {$CADDY_TLS}
	# Compression : API (instantané de synchronisation…) et fichiers.
	encode zstd gzip
}

*.{$MWANGAZA_DOMAIN} {
	import site
	import ecole
}

parents.{$MWANGAZA_DOMAIN} {
	import site
	import parents
}

admin.{$MWANGAZA_DOMAIN} {
	import site
	import admin
}

# Domaine nu : le site public de la plateforme (`vitrine`) ; www y renvoie (une seule adresse
# pour les moteurs de recherche).
{$MWANGAZA_DOMAIN} {
	import site
	import vitrine
}

www.{$MWANGAZA_DOMAIN} {
	import site
	redir https://{$MWANGAZA_DOMAIN}{uri} permanent
}

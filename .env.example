# Copier en `.env` à la racine (jamais commité) pour `make dev-local`, `make test`, `make migrate`…
# Avec `make dev` (Docker), ces valeurs ne servent pas : docker-compose.dev.yml a les siennes.

DJANGO_SECRET_KEY=
# 5433 = PostgreSQL de Docker (`make services`) ; 5432 = PostgreSQL installé sur la machine.
POSTGRES_DB=mwangaza
POSTGRES_USER=mwangaza
POSTGRES_PASSWORD=mwangaza
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6379/0
# true = tâches Celery exécutées tout de suite, sans Redis ni worker.
CELERY_TASK_ALWAYS_EAGER=true

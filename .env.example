# Copier en `.env` à la racine (jamais commité) pour `make dev-local`, `make test`, `make migrate`…
# Avec `make dev` (Docker), ces valeurs ne servent pas : docker-compose.dev.yml a les siennes.

# Vide = clé de développement par défaut (rien à remplir sur ta machine). Obligatoire en production.
DJANGO_SECRET_KEY=
# Après un changement de DJANGO_SECRET_KEY : l'ancienne ici (séparées par des virgules). Sans elle,
# les sessions sont fermées et chacun doit réactiver sa double authentification.
DJANGO_SECRET_KEY_FALLBACKS=
# 5433 = PostgreSQL de Docker (`make services`) ; 5432 = PostgreSQL installé sur la machine.
POSTGRES_DB=mwangaza
POSTGRES_USER=mwangaza
POSTGRES_PASSWORD=mwangaza
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6379/0
# Notifications sur l'écran (Web Push) : vides = clés de développement de `config/settings/dev.py`.
# Clé de l'API Anthropic (IA.1.1) : vide = l'IA répond « non configurée ».
ANTHROPIC_API_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# true = tâches Celery exécutées tout de suite, sans Redis ni worker.
CELERY_TASK_ALWAYS_EAGER=true
